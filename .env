# === Backend ===
VITE_API_BASE_URL=http://localhost:8080
VITE_AUTH_MODE=api

# === Mercado Pago — Token da Plataforma (conta central Genesis) ===
# ATENÇÃO: Nunca exponha este token no frontend. Apenas no backend (server.js).
MERCADOPAGO_ACCESS_TOKEN=APP_USR-5076214841905920-081112-768e0648179ce52ceb48a90a14882388-1214160384

# === Mercado Pago — Chave Pública (usada no frontend para inicializar o SDK MP) ===
VITE_MERCADOPAGO_PUBLIC_KEY=APP_USR-89e1340b-b66b-4fa3-a0cb-99a38667da22

# === OAuth 2.0 — Credenciais da Aplicação MP (para Split/Marketplace) ===
# Obtenha em: https://www.mercadopago.com.br/developers/panel/app
# SEGURANÇA: Nunca comite estas variáveis no Git!
MP_CLIENT_ID=
MP_CLIENT_SECRET=
MP_REDIRECT_URI=http://localhost:8080/api/auth/mercadopago/callback

# === Split — Taxa da Plataforma Genesis (application_fee) ===
# Valor fixo em reais retido a cada pagamento. Ex: 5 = R$ 5,00 por inscrição.
# Deixe 0 para não cobrar taxa.
MP_PLATFORM_FEE=0
